{
  "name": "ruin321s-baldi-mod-manager",
  "productName": "Ruin321's Baldi's Basics Plus Mod Manager",
  "version": "0.1.3",
  "description": "Baldi's Basics Plus mod manager",
  "main": "./out/main/index.js",
  "author": { "name": "RUIN321 GAMES", "email": "ruin321games@users.noreply.github.com" },
  "license": "MIT",
  "private": true,
  "build": {
    "appId": "com.ruin321.baldi-mod-manager",
    "productName": "Ruin321's Baldi's Basics Plus Mod Manager",
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/7z",
        "to": "7z"
      },
      {
        "from": "resources/BepInEx.zip",
        "to": "BepInEx.zip"
      },
      {
        "from": "resources/apps.ico",
        "to": "apps.ico"
      }
    ],
    "protocols": [
      {
        "name": "Ruin321's Baldi's Basics Plus Mod Manager",
        "schemes": [
          "rbbpmm"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${name}-Setup-${version}.${ext}"
    }
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:win": "electron-vite build && electron-builder --win",
    "preview": "electron-vite preview"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.2",
    "adm-zip": "^0.5.16",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "electron-store": "^8.2.0",
    "lucide-react": "^0.436.0",
    "p-limit": "^5.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "^1.5.0",
    "tailwind-merge": "^2.5.2",
    "tailwindcss-animate": "^1.0.7",
    "7zip-bin": "^5.2.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.5",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.4",
    "vite": "^5.3.5"
  }
}
