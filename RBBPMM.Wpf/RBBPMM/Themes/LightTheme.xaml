<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- 标记键，便于 ThemeManager 识别并替换当前主题字典 -->
    <sys:String x:Key="__ThemeTag__">Light</sys:String>

    <!-- 调色板：对应 Electron 里 Tailwind 指向 CSS 变量的换肤思路 -->
    <Color x:Key="BgColor">#F4F1EA</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="SurfaceAltColor">#EDE9DE</Color>
    <Color x:Key="BorderColor">#D8D2C2</Color>
    <Color x:Key="TextColor">#2B2B2B</Color>
    <Color x:Key="TextMutedColor">#6E6A5E</Color>
    <Color x:Key="PrimaryColor">#F2B705</Color>
    <Color x:Key="PrimaryHoverColor">#FFC83D</Color>
    <Color x:Key="PrimaryTextColor">#2B2B2B</Color>
    <Color x:Key="DangerColor">#D64545</Color>
    <Color x:Key="SuccessColor">#2E9E5B</Color>
    <Color x:Key="NavActiveColor">#FFF3CF</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryHoverColor}"/>
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="NavActiveBrush" Color="{StaticResource NavActiveColor}"/>

    <!-- 形状令牌：对应 Electron 的圆角变量 -->
    <CornerRadius x:Key="Radius">10</CornerRadius>
    <CornerRadius x:Key="RadiusSm">6</CornerRadius>
    <CornerRadius x:Key="RadiusLg">16</CornerRadius>
    <Thickness x:Key="Pad">12</Thickness>
    <FontFamily x:Key="UiFont">Segoe UI</FontFamily>
</ResourceDictionary>
