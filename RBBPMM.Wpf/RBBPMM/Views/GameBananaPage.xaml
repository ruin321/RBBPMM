<UserControl x:Class="RBBPMM.Views.GameBananaPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:RBBPMM.ViewModels"
             xmlns:loc="clr-namespace:RBBPMM.Localization"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:GameBananaPageViewModel}">
    <StackPanel>
        <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="Bold"
                   Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8"/>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="{loc:Loc Key=gamebanana.empty}"
                           Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
                <TextBlock Text="{loc:Loc Key=gamebanana.emptyHint}"
                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
