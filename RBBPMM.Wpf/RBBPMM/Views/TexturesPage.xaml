<UserControl x:Class="RBBPMM.Views.TexturesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:RBBPMM.ViewModels"
             xmlns:loc="clr-namespace:RBBPMM.Localization"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:TexturesPageViewModel}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── 顶部：标题 / 目录引导 / 工具条 / 状态 ── -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="Bold" Margin="0,0,0,8"/>

            <Border Style="{StaticResource Card}"
                    Visibility="{Binding IsGameMissing, Converter={StaticResource BoolToVis}}"
                    Margin="0,0,0,10">
                <TextBlock Text="{loc:Loc Key=game.notSetHint}" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextMutedBrush}"/>
            </Border>

            <DockPanel LastChildFill="True" Margin="0,0,0,8">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="{loc:Loc Key=common.refresh}" Command="{Binding RefreshCommand}"
                            Style="{StaticResource BaseButton}" Margin="6,0,0,0"/>
                    <Button Content="{loc:Loc Key=textures.openPacksRoot}" Command="{Binding OpenPacksRootCommand}"
                            Style="{StaticResource BaseButton}" Margin="6,0,0,0"/>
                    <Button Content="{loc:Loc Key=textures.installFromFile}" Command="{Binding InstallCommand}"
                            Style="{StaticResource PrimaryButton}" Margin="6,0,0,0"/>
                </StackPanel>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=120}"
                         ToolTip="{loc:Loc Key=textures.search}" Margin="0,0,6,0"/>
            </DockPanel>

            <TextBlock Text="{Binding Status}" Margin="0,0,0,8" TextWrapping="Wrap"
                       Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}"
                       Foreground="{DynamicResource TextMutedBrush}"/>
        </StackPanel>

        <!-- ── 左：材质包列表　右：README 预览 ── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="240"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="2*" MinWidth="200"/>
            </Grid.ColumnDefinitions>

            <ListBox Grid.Column="0"
                     ItemsSource="{Binding VisiblePacks}"
                     SelectedItem="{Binding SelectedPack, Mode=TwoWay}"
                     Visibility="{Binding HasPacks, Converter={StaticResource BoolToVis}}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource RowCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" MinWidth="0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <Border Style="{StaticResource Badge}"
                                                Visibility="{Binding Protected, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{loc:Loc Key=textures.protectedBadge}" FontSize="10"
                                                       Foreground="{DynamicResource TextMutedBrush}"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- 作者/版本都缺失时整行隐藏，否则会剩一个孤零零的「·」 -->
                                    <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Visibility="{Binding HasMeta, Converter={StaticResource BoolToVis}}">
                                        <Run Text="{Binding Author, Mode=OneWay}"/>
                                        <Run Text="·"/>
                                        <Run Text="{Binding Version, Mode=OneWay}"/>
                                    </TextBlock>

                                    <TextBlock Text="{Binding FolderName}" FontSize="10" Margin="0,2,0,0"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                            VerticalAlignment="Top" Margin="12,0,0,0">
                                    <Button Content="{loc:Loc Key=common.openFolder}"
                                            Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource BaseButton}"/>
                                    <Button Content="{loc:Loc Key=common.uninstall}"
                                            Command="{Binding DataContext.UninstallCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}"
                                            IsEnabled="{Binding CanUninstall}"
                                            Style="{StaticResource DangerButton}" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 空态 -->
            <Border Grid.Column="0" Style="{StaticResource Card}"
                    VerticalAlignment="Top"
                    Visibility="{Binding HasPacks, Converter={StaticResource NotBoolToVis}}">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Key=textures.empty}" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                    <TextBlock Text="{loc:Loc Key=textures.emptyHint}" Margin="0,6,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                </StackPanel>
            </Border>

            <!-- README 面板 -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top" Text="{loc:Loc Key=textures.readme}"
                               FontWeight="SemiBold" Margin="14,12,14,8"/>

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding HasReadme, Converter={StaticResource BoolToVis}}">
                        <TextBox Text="{Binding Readme, Mode=OneWay}"
                                 IsReadOnly="True" TextWrapping="Wrap"
                                 AcceptsReturn="True" BorderThickness="0"
                                 Background="Transparent" Padding="14,0,14,12"
                                 FontFamily="Consolas" FontSize="11"/>
                    </ScrollViewer>

                    <TextBlock Text="{loc:Loc Key=textures.readmeHint}"
                               Visibility="{Binding HasReadme, Converter={StaticResource NotBoolToVis}}"
                               Margin="14,0,14,14" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
