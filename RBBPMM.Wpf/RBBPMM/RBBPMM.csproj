<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\RBBPMM.Core\RBBPMM.Core.csproj" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Resources\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 运行时依赖：7z 与 BepInEx 包必须随程序一起发布，否则「装 BepInEx」「装 rar/7z 包」
       会在运行时才失败。Link 决定落点，必须和 Core 里 ResolveSevenZip /
       ResolveBepInExArchive 的默认查找路径一致（<BaseDir>\7z\7z.exe、<BaseDir>\BepInEx.zip）。
       只带 Windows 的两支，Electron 时代 resources/7z 下的 linux/mac 目录不随包发。 -->
  <ItemGroup>
    <Content Include="..\resources\7z\7z.exe" Link="7z\7z.exe"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\resources\7z\7z.dll" Link="7z\7z.dll"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\resources\BepInEx.zip" Link="BepInEx.zip"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 彩蛋素材：打进程序集（WPF 的 Resource 项），和 Electron 版把 gif 打进 bundle 等效 -->
  <ItemGroup>
    <Resource Include="Assets\*.gif" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>

    <ApplicationIcon>Assets\apps.ico</ApplicationIcon>
    <AssemblyTitle>RBBPMM</AssemblyTitle>
    <Product>RBBPMM — Baldi's Basics Plus Mod Manager</Product>
    <Description>Manage Baldi's Basics Plus mods, texture packs and custom levels.</Description>
    <Company>ruin321</Company>
    <Version>0.1.4</Version>
  </PropertyGroup>

  <!-- WPF 的 ImplicitUsings 集合不含 System.IO（Path/File/Directory），全项目补一个全局 using -->
  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>

</Project>
