<Application x:Class="RBBPMM.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RBBPMM"
             xmlns:conv="clr-namespace:RBBPMM.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- bool → Visibility（页面里大量「有/无」区块切换） -->
            <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
            <!-- 取反版：给「无数据时显示空态」这类场景用 -->
            <conv:InverseBoolToVisibilityConverter x:Key="NotBoolToVis"/>
            <!-- 取反布尔：给 IsEnabled 用（受保护 → 禁用按钮） -->
            <conv:InverseBoolConverter x:Key="NotBool"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
